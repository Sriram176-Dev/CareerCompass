# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/career-compass

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_URL=http://localhost:5173

# ─── Vite (frontend) ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api

# ─── Gemini API Key (single key, shared by every AI feature) ─────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional overrides (sensible defaults are set in code — only change these
# if you specifically want a different Gemini model or concurrency ceiling)
# GEMINI_MODEL_FLASH=gemini-3.1-flash-lite
# GEMINI_MODEL_PRO=gemini-3-flash-preview
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIM=768
# GEMINI_MAX_CONCURRENCY=4

# ─── Email (password reset) ───────────────────────────────────────────────────
# Gmail with App Password (enable 2FA → myaccount.google.com/apppasswords)
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
# Or custom SMTP:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_key
